<Window x:Class="DnDMapHelper.Views.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DnDMapHelper.Controls"
        Title="Экран мастера — Карта приключений"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource FantasyWindow}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource FantasyPanel}" Margin="8,8,8,4" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Загрузить карту" Style="{StaticResource FantasyButton}" Click="LoadMap_Click"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ToolNavigate" Content="Обзор" Style="{StaticResource FantasyToolButton}"
                                  Checked="Tool_Checked" Tag="Navigate"/>
                    <ToggleButton x:Name="ToolParty" Content="Метка партии" Style="{StaticResource FantasyToolButton}"
                                  Checked="Tool_Checked" Tag="PartyMarker"/>
                    <ToggleButton x:Name="ToolTarget" Content="Метка цели" Style="{StaticResource FantasyToolButton}"
                                  Checked="Tool_Checked" Tag="TargetMarker"/>
                    <ToggleButton x:Name="ToolPath" Content="Маршрут" Style="{StaticResource FantasyToolButton}"
                                  Checked="Tool_Checked" Tag="DrawPath"/>
                    <ToggleButton x:Name="ToolRegion" Content="Описание области" Style="{StaticResource FantasyToolButton}"
                                  Checked="Tool_Checked" Tag="DrawRegion"/>
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MoveButton" Content="⚔ Движение"
                            Style="{StaticResource FantasyButton}" Click="MoveButton_Click"/>
                    <Button Content="Экран игры ▶" Style="{StaticResource FantasyButton}" Click="OpenPlayer_Click"/>
                    <Button x:Name="TogglePlayerWindowButton" Content="Свернуть игроков"
                            Style="{StaticResource FantasyButton}" Click="TogglePlayerWindow_Click"
                            IsEnabled="False" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource FantasyPanel}" Margin="8,4,8,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkBrush}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="?"
                        Style="{StaticResource FantasyButton}"
                        Width="40" Height="40"
                        FontSize="20" FontWeight="Bold"
                        Padding="0" VerticalAlignment="Center"
                        ToolTip="Справка — как пользоваться программой"
                        Click="HelpButton_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Right" Style="{StaticResource FantasyPanel}" Margin="0,0,8,0"
                Width="240" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Очередь маршрутов" Style="{StaticResource FantasyTitle}"
                           FontSize="15" Margin="0,0,0,8"/>

                <ListBox x:Name="RouteList" Grid.Row="1"
                         SelectionChanged="RouteList_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="{StaticResource FantasyBodyFont}"
                         FontSize="13">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="RouteQueueHint" FontSize="11" FontStyle="Italic"
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,6"/>
                    <Button Content="Очистить маршруты" Style="{StaticResource FantasyButton}"
                            FontSize="11" Padding="8,4" Margin="0,0,0,4" Click="ClearRoutes_Click"/>
                    <Button Content="Удалить выбранный" Style="{StaticResource FantasyButton}"
                            FontSize="11" Padding="8,4" Click="RemoveSelectedRoute_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="8,0" BorderBrush="{StaticResource LeatherBrush}" BorderThickness="4" CornerRadius="2">
            <controls:MapCanvas x:Name="MapView"
                                HighlightRegions="True"
                                MouseLeftButtonDown="MapView_MouseLeftButtonDown"
                                MouseRightButtonDown="MapView_MouseRightButtonDown"
                                MouseDoubleClick="MapView_MouseDoubleClick"
                                MouseMove="MapView_MouseMove"
                                MouseLeftButtonUp="MapView_MouseLeftButtonUp"/>
        </Border>
    </DockPanel>
</Window>
