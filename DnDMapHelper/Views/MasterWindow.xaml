<Window x:Class="DnDMapHelper.Views.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DnDMapHelper.Controls"
        Title="Экран мастера — Карта приключений"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource FantasyWindow}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource FantasyCompactPanel}" Margin="4,4,4,2" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Открыть" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Открыть сохранённую карту (.dndmap)" Click="OpenSession_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Сохранить карту и все метки (.dndmap)" Click="SaveSession_Click"/>
                    <Button Content="Карта" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Загрузить только изображение (сбросит метки)" Click="LoadMap_Click"/>
                    <Button Content="+" Style="{StaticResource FantasyCompactButton}" Width="28" Padding="0"
                            ToolTip="Приблизить карту" Click="ZoomIn_Click"/>
                    <Button Content="−" Style="{StaticResource FantasyCompactButton}" Width="28" Padding="0"
                            ToolTip="Отдалить карту" Click="ZoomOut_Click"/>
                    <Button Content="⊡" Style="{StaticResource FantasyCompactButton}" Width="28" Padding="0"
                            ToolTip="Исходный размер карты" Click="ResetZoom_Click"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ToolNavigate" Content="Обзор" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Обзор и выбор объектов" Checked="Tool_Checked" Tag="Navigate"/>
                    <ToggleButton x:Name="ToolParty" Content="Партия" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Метка партии" Checked="Tool_Checked" Tag="PartyMarker"/>
                    <ToggleButton x:Name="ToolTarget" Content="Цель" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Метка цели" Checked="Tool_Checked" Tag="TargetMarker"/>
                    <ToggleButton x:Name="ToolEncounter" Content="Бой" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Столкновение" Checked="Tool_Checked" Tag="EncounterMarker"/>
                    <ToggleButton x:Name="ToolPath" Content="Путь" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Нарисовать маршрут" Checked="Tool_Checked" Tag="DrawPath"/>
                    <ToggleButton x:Name="ToolRegion" Content="Область" Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Описание области" Checked="Tool_Checked" Tag="DrawRegion"/>
                </WrapPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="ToggleQuestJournal" Content="Квесты"
                                  Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Журнал квестов — задания, подсветка целей на карте"
                                  Checked="ToggleQuestJournal_Checked"
                                  Unchecked="ToggleQuestJournal_Checked"/>
                    <ToggleButton x:Name="ToggleRouteJournal" Content="Маршруты"
                                  Style="{StaticResource FantasyCompactToolButton}"
                                  ToolTip="Очередь маршрутов — список, просмотр, очистка"
                                  Checked="ToggleRouteJournal_Checked"
                                  Unchecked="ToggleRouteJournal_Checked"/>
                    <Button x:Name="MoveButton" Content="⚔"
                            Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Движение отряда по первому маршруту в очереди" Click="MoveButton_Click"/>
                    <Button Content="▶" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Открыть экран игры для игроков" Click="OpenPlayer_Click"/>
                    <Button x:Name="TogglePlayerWindowButton" Content="Свернуть"
                            Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Свернуть окно игроков"
                            Click="TogglePlayerWindow_Click"
                            IsEnabled="False" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource FantasyCompactPanel}" Margin="4,2,4,4" Padding="4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkBrush}" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11">
                        <Hyperlink Click="AboutLink_Click"
                                   Foreground="{StaticResource GoldBrush}"
                                   TextDecorations="None"
                                   ToolTip="О программе">
                            О программе
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="?"
                            Style="{StaticResource FantasyCompactButton}"
                            Width="32" Height="32"
                            FontSize="16" FontWeight="Bold"
                            Padding="0"
                            ToolTip="Справка — как пользоваться программой"
                            Click="HelpButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="QuestJournalPanel" DockPanel.Dock="Left" Style="{StaticResource FantasyCompactPanel}"
                Width="260" Visibility="Collapsed">
            <controls:QuestJournalControl x:Name="QuestJournal" IsMasterMode="True"/>
        </Border>

        <Border x:Name="RouteJournalPanel" DockPanel.Dock="Right" Style="{StaticResource FantasyCompactPanel}"
                Width="220" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Маршруты" Style="{StaticResource FantasyTitle}"
                           FontSize="14" Margin="0,0,0,6"/>

                <ListBox x:Name="RouteList" Grid.Row="1"
                         SelectionChanged="RouteList_SelectionChanged"
                         FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Padding="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="RouteQueueHint" FontSize="10" FontStyle="Italic"
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,4"/>
                    <Button Content="Очистить" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Очистить все маршруты" Click="ClearRoutes_Click"/>
                    <Button Content="Удалить" Style="{StaticResource FantasyCompactButton}"
                            ToolTip="Удалить выбранный маршрут" Click="RemoveSelectedRoute_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="4,0" BorderBrush="{StaticResource LeatherBrush}" BorderThickness="2" CornerRadius="2">
            <controls:MapCanvas x:Name="MapView"
                                HighlightRegions="True"
                                PreviewMouseLeftButtonDown="MapView_MouseLeftButtonDown"
                                PreviewMouseRightButtonDown="MapView_MouseRightButtonDown"
                                PreviewMouseDoubleClick="MapView_MouseDoubleClick"
                                PreviewMouseMove="MapView_MouseMove"
                                PreviewMouseLeftButtonUp="MapView_MouseLeftButtonUp"/>
        </Border>
    </DockPanel>
</Window>
