<Window x:Class="DnDMapHelper.Views.TargetLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подпись цели"
        Width="440" Height="300"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource FantasyWindow}">
    <Border Style="{StaticResource FantasyPanel}" Margin="16" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Имя метки цели" Style="{StaticResource FantasyTitle}"
                       FontSize="18" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Название цели" Margin="0,0,0,8" FontWeight="SemiBold"/>
                <TextBlock Text="Например: Логово врага, Мост, Деревня"
                           Margin="0,0,0,10" FontStyle="Italic" Opacity="0.75"/>
                <TextBox x:Name="LabelBox" Style="{StaticResource FantasySingleLineTextBox}"
                         Height="48" MinHeight="48"
                         FontSize="15"
                         MaxLength="64"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource FantasyButton}" Width="100" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource FantasyButton}" Width="120" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
