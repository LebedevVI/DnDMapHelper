<Window x:Class="DnDMapHelper.Views.MapGridDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сетка карты"
        Width="440" Height="440"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource FantasyWindow}">
    <Border Style="{StaticResource FantasyPanel}" Margin="12" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Сетка для мастера" Style="{StaticResource FantasyTitle}"
                       FontSize="18" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Opacity="0.9" Margin="0,0,0,12"
                       Text="Сетка видна только на экране мастера. По ней считается протяжённость маршрутов в километрах."/>

            <CheckBox x:Name="ShowGridCheckBox" Grid.Row="2"
                      Content="Показывать сетку"
                      Margin="0,0,0,14"/>

            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Размер клетки (пиксели карты):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="CellSizeBox"
                         Style="{StaticResource FantasySingleLineTextBox}"
                         FontSize="15"
                         MaxLength="12"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Text="Одна клетка = километров:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="KilometersBox"
                         Style="{StaticResource FantasySingleLineTextBox}"
                         FontSize="15"
                         MaxLength="12"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Отмена" Style="{StaticResource FantasyButton}" Width="100" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Сохранить" Style="{StaticResource FantasyButton}" Width="120"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
