<Window x:Class="DnDMapHelper.Views.QuestEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Квест"
        Width="560" Height="680"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource FantasyWindow}">
    <Border Style="{StaticResource FantasyPanel}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Запись в журнале квестов" Style="{StaticResource FantasyTitle}"
                       FontSize="18" Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Название:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox" MinHeight="36" Margin="0,0,0,10" MaxLength="100"/>

                    <TextBlock Text="Условия:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="ConditionsBox" MinHeight="56" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                    <TextBlock Text="Описание задачи:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionBox" MinHeight="72" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                    <TextBlock Text="Награда:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="RewardBox" MinHeight="56" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                    <TextBlock Text="Кому сдать:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TurnInCombo" DisplayMemberPath="Label" Margin="0,0,0,10"/>

                    <TextBlock Text="Цели квеста (куда идти, с кем говорить):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="ObjectiveList" DisplayMemberPath="Label"
                             SelectionMode="Extended" MinHeight="80" MaxHeight="120" Margin="0,0,0,10"/>

                    <TextBlock Text="Области выполнения:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="RegionList" DisplayMemberPath="Title"
                             SelectionMode="Extended" MinHeight="80" MaxHeight="120"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Отмена" Style="{StaticResource FantasyButton}" Width="100" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource FantasyButton}" Width="120"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
