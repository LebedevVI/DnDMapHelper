<Window x:Class="DnDMapHelper.Views.RegionTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Описание области"
        Width="500" Height="460"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource FantasyWindow}">
    <Border Style="{StaticResource FantasyPanel}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Свиток земель" Style="{StaticResource FantasyTitle}"
                       FontSize="18" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="1" Text="Заголовок:" Margin="0,0,0,6" FontWeight="SemiBold"/>

            <TextBox x:Name="TitleBox" Grid.Row="2"
                     MinHeight="44"
                     Margin="0,0,0,12"
                     VerticalContentAlignment="Center"
                     VerticalScrollBarVisibility="Disabled"
                     AcceptsReturn="False"
                     TextWrapping="NoWrap"
                     MaxLength="80"/>

            <TextBlock Grid.Row="3" Text="Описание для игроков:" Margin="0,0,0,6" FontWeight="SemiBold"/>

            <TextBox x:Name="DescriptionBox" Grid.Row="4"
                     MinHeight="160"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" Style="{StaticResource FantasyButton}" Width="100" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource FantasyButton}" Width="120" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
