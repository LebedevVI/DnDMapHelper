<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Images\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\DM_view.png" />
    <None Remove="Images\Player_view.png" />
    <None Remove="Images\Quest_create.png" />
    <None Remove="Images\Region.png" />
    <None Remove="Images\Route_create.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\DM_view.png" />
    <EmbeddedResource Include="Images\Player_view.png" />
    <EmbeddedResource Include="Images\Quest_create.png" />
    <EmbeddedResource Include="Images\Region.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Route_create.png" />
  </ItemGroup>

</Project>
