<UserControl x:Class="DnDMapHelper.Controls.QuestJournalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Журнал квестов" Style="{StaticResource FantasyTitle}"
                   FontSize="14" Margin="0,0,0,6"/>

        <ListBox x:Name="QuestList" Grid.Row="1"
                 DisplayMemberPath="JournalDisplayName"
                 SelectionChanged="QuestList_SelectionChanged"
                 FontSize="12" MinHeight="80"/>

        <Border Grid.Row="2" Margin="0,6,0,0" Padding="6"
                Background="#33C9A86C" CornerRadius="3" BorderBrush="{StaticResource LeatherBrush}"
                BorderThickness="1">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="QuestDetailsPanel" Opacity="0.85">
                    <TextBlock x:Name="QuestDetailsPlaceholder"
                               Text="Выберите квест — его цели подсветятся на карте."
                               FontStyle="Italic" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock x:Name="QuestConditionsText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="QuestDescriptionText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="QuestRewardText" TextWrapping="Wrap" FontSize="11"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="MasterEditPanel" Grid.Row="3" Margin="0,6,0,0">
            <Button Content="Новый" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Создать новый квест"
                    Click="NewQuest_Click"/>
            <Button Content="Изменить" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Редактировать выбранный квест"
                    Click="EditQuest_Click"/>
            <Button Content="Удалить" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Удалить квест из журнала"
                    Click="DeleteQuest_Click"/>
        </StackPanel>

        <WrapPanel x:Name="MasterStatusPanel" Grid.Row="4" Margin="0,6,0,0">
            <Button Content="Активен" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Вернуть в работу — все связанные метки снова видны"
                    Click="MarkQuestActive_Click"/>
            <Button Content="К сдаче" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Готов к сдаче — на карте остаётся только точка сдачи"
                    Click="MarkQuestReady_Click"/>
            <Button Content="Выполнен" Style="{StaticResource FantasyCompactButton}"
                    ToolTip="Закрыть квест — связанные метки исчезнут с карты"
                    Click="MarkQuestComplete_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
