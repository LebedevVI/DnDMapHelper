<Window x:Class="DnDMapHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DnD Map Helper — Хроники карты"
        Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource FantasyWindow}">
    <Border Style="{StaticResource FantasyPanel}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="☙ Хроники карты ☙" Style="{StaticResource FantasyTitle}" FontSize="28" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Помощник мастера для отображения карт игрокам"
                       TextAlignment="Center" FontStyle="Italic" Opacity="0.8" Margin="0,0,0,24"/>

            <Border Grid.Row="2" BorderBrush="{StaticResource LeatherBrush}" BorderThickness="0,2,0,2"
                    Padding="0,20" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" LineHeight="24" Margin="16,0"
                               FontSize="14">
                        Откройте экран мастера для подготовки карты: метки партии и целей,
                        маршруты движения и области с описаниями земель.
                        <LineBreak/><LineBreak/>
                        Экран игры показывает карту на весь дисплей — игроки двигают отряд
                        и читают справки о выделенных областях.
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3">
                <Button Content="Экран мастера" Style="{StaticResource FantasyButton}"
                        FontSize="16" Margin="40,4" Click="OpenMaster_Click"/>
                <Button Content="Экран игры (игроки)" Style="{StaticResource FantasyButton}"
                        FontSize="16" Margin="40,4" Click="OpenPlayer_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
